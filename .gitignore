# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore build and dependency directories
node_modules/
dist/
build/
out/
bin/
obj/

# Ignore log files and databases
*.log
*.sqlite
*.db

# Ignore environment files
.env
.env.local
.env.development
.env.test
.env.production

# Ignore compiled files
*.class
*.exe
*.dll
*.so
*.o
*.a

# Ignore temporary files
*.tmp
*.bak
*.swp
*.swo

# Ignore package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore coverage reports
coverage/
.nyc_output/

# Ignore other common files
*.zip
*.tar.gz
*.rar